#!/usr/bin/env bash
set -Eeuo pipefail

# AppImage has to remain self-contained, but Blinkora cannot run directly from
# its FUSE mount: this launcher exits after opening the browser, which unmounts
# the image while the server still needs to read its static assets.  A
# versioned, immutable runtime copy solves that problem while keeping user data
# outside the upgradeable application image.

APP_DIR="${APPDIR:-$(cd "$(dirname "$0")" && pwd)}"
SOURCE_RUNTIME="$APP_DIR/usr/lib/blinkora"

if [[ ! -x "$SOURCE_RUNTIME/blinkora-server" || ! -d "$SOURCE_RUNTIME/public" || ! -f "$SOURCE_RUNTIME/db/schema.sqlite.sql" || ! -f "$SOURCE_RUNTIME/VERSION" ]]; then
  echo "error: Blinkora AppImage runtime is incomplete" >&2
  exit 1
fi

VERSION="$(tr -d '\r\n' < "$SOURCE_RUNTIME/VERSION")"
if [[ ! "$VERSION" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "error: Blinkora AppImage contains an invalid runtime version" >&2
  exit 1
fi

DATA_ROOT="${BLINKORA_DATA_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/blinkora}"
STATE_ROOT="${XDG_STATE_HOME:-$HOME/.local/state}/blinkora"
CONFIG_ROOT="${XDG_CONFIG_HOME:-$HOME/.config}/blinkora"
DATA_DIR="$DATA_ROOT/data"
RUNTIME_ROOT="$STATE_ROOT/runtime"
RUNTIME_DIR="$RUNTIME_ROOT/$VERSION"
LOG_DIR="$STATE_ROOT/logs"
ENV_FILE="$CONFIG_ROOT/blinkora.env"
PID_FILE="$STATE_ROOT/server.pid"
PORT="${BLINKORA_PORT:-6676}"
URL="http://127.0.0.1:$PORT"

if [[ ! "$PORT" =~ ^[1-9][0-9]{0,4}$ ]] || ((PORT > 65535)); then
  echo "error: BLINKORA_PORT must be an integer from 1 to 65535" >&2
  exit 2
fi

usage() {
  cat <<'EOF'
Usage: Blinkora-x86_64.AppImage [--status | --stop | --restart | --headless]

Without arguments, start Blinkora if needed and open it in the default browser.
--headless starts it without opening a browser; --restart replaces an existing
local server with this AppImage's bundled runtime.
EOF
}

ensure_private_dir() {
  mkdir -p "$1"
  chmod 700 "$1"
}

prepare_paths() {
  umask 077
  ensure_private_dir "$DATA_ROOT"
  ensure_private_dir "$DATA_DIR"
  ensure_private_dir "$STATE_ROOT"
  ensure_private_dir "$RUNTIME_ROOT"
  ensure_private_dir "$LOG_DIR"
  ensure_private_dir "$CONFIG_ROOT"
}

write_env_file_if_missing() {
  if [[ -f "$ENV_FILE" ]]; then
    chmod 600 "$ENV_FILE"
    return
  fi

  local secret temporary
  secret="$(od -vAn -N32 -tx1 /dev/urandom | tr -d ' \n')"
  if [[ ${#secret} -ne 64 ]]; then
    echo "error: could not generate a local Blinkora secret" >&2
    exit 1
  fi
  temporary="$(mktemp "$CONFIG_ROOT/.blinkora.env.XXXXXX")"
  printf 'BLINKORA_SECRET=%s\n' "$secret" > "$temporary"
  chmod 600 "$temporary"
  mv "$temporary" "$ENV_FILE"
}

prepare_runtime() {
  if [[ -x "$RUNTIME_DIR/blinkora-server" && -d "$RUNTIME_DIR/public" && -f "$RUNTIME_DIR/db/schema.sqlite.sql" ]]; then
    return
  fi

  local temporary
  temporary="$(mktemp -d "$RUNTIME_ROOT/.${VERSION}.XXXXXX")"
  trap 'rm -rf "$temporary"' RETURN
  cp -a "$SOURCE_RUNTIME/." "$temporary/"
  chmod 700 "$temporary"
  chmod 755 "$temporary/blinkora-server"
  find "$temporary/public" -type d -exec chmod 755 {} +
  find "$temporary/public" -type f -exec chmod 644 {} +
  chmod 600 "$temporary/db/schema.sqlite.sql"

  if ! mv "$temporary" "$RUNTIME_DIR" 2>/dev/null; then
    rm -rf "$temporary"
    if [[ ! -x "$RUNTIME_DIR/blinkora-server" ]]; then
      echo "error: could not install Blinkora runtime $VERSION" >&2
      exit 1
    fi
  fi
  trap - RETURN
}

read_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(tr -d '[:space:]' < "$PID_FILE")"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "$pid"
}

server_is_running() {
  local pid
  pid="$(read_pid)" || return 1
  kill -0 "$pid" 2>/dev/null
}

wait_for_server() {
  local attempt
  for ((attempt = 0; attempt < 50; attempt += 1)); do
    if ! server_is_running; then
      return 1
    fi
    if (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; then
      exec 3>&- 3<&-
      return 0
    fi
    sleep 0.1
  done
  return 1
}

stop_server() {
  local pid
  if ! pid="$(read_pid)"; then
    rm -f "$PID_FILE"
    return
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    rm -f "$PID_FILE"
    return
  fi

  kill -TERM "$pid"
  local attempt
  for ((attempt = 0; attempt < 50; attempt += 1)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$PID_FILE"
      return
    fi
    sleep 0.1
  done
  echo "error: Blinkora did not stop within 5 seconds" >&2
  exit 1
}

start_server() {
  prepare_runtime
  write_env_file_if_missing

  set -a
  # The file is created by this launcher with mode 0600 and only contains the
  # generated secret. It is intentionally not passed on the command line.
  source "$ENV_FILE"
  set +a

  NODE_ENV=production \
  BIND_ADDR=127.0.0.1 \
  PORT="$PORT" \
  PUBLIC_PATH="$RUNTIME_DIR/public" \
  DATA_DIR="$DATA_DIR" \
  SCHEMA_PATH="$RUNTIME_DIR/db/schema.sqlite.sql" \
  nohup "$RUNTIME_DIR/blinkora-server" 9>&- >>"$LOG_DIR/server.log" 2>&1 < /dev/null &
  local pid=$!
  printf '%s\n' "$pid" > "$PID_FILE"
  chmod 600 "$PID_FILE"

  if ! wait_for_server; then
    rm -f "$PID_FILE"
    echo "error: Blinkora did not become ready; see $LOG_DIR/server.log" >&2
    exit 1
  fi
}

open_browser() {
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$URL" >/dev/null 2>&1 &
  elif command -v gio >/dev/null 2>&1; then
    gio open "$URL" >/dev/null 2>&1 &
  else
    echo "Blinkora is running at $URL"
  fi
}

prepare_paths
exec 9>"$STATE_ROOT/launcher.lock"
if ! flock -n 9; then
  echo "error: another Blinkora launcher operation is in progress" >&2
  exit 1
fi

case "${1:-}" in
  --help|-h)
    usage
    ;;
  --status)
    if server_is_running; then
      echo "Blinkora is running at $URL"
    else
      echo "Blinkora is not running"
      exit 3
    fi
    ;;
  --stop)
    stop_server
    echo "Blinkora stopped"
    ;;
  --restart)
    stop_server
    start_server
    open_browser
    ;;
  --headless)
    if ! server_is_running; then
      start_server
    fi
    echo "Blinkora is running at $URL"
    ;;
  '')
    if ! server_is_running; then
      start_server
    fi
    open_browser
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
