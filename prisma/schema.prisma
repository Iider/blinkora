generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

// generator zod {
//   provider = "zod-prisma-types"
// }

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model accounts {
  id            Int             @id @default(autoincrement())
  name          String          @default("") @db.VarChar
  nickname      String          @default("") @db.VarChar
  password      String          @default("") @db.VarChar
  image         String          @default("") @db.VarChar
  apiToken      String          @default("") @db.VarChar
  description   String          @default("") @db.Text
  note          Int             @default(0)
  role          String          @default("") @db.VarChar
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @db.Timestamptz(6)
  notes         notes[]
  configs       config[]
  tags          tag[]
  attachments   attachments[]
  comments      comments[]
  workspaces    workspaces[]
}

model workspaces {
  id          Int          @id @default(autoincrement())
  name        String       @default("默认工作区") @db.VarChar
  description String       @default("") @db.VarChar
  icon        String       @default("") @db.VarChar
  color       String       @default("") @db.VarChar
  accountId   Int
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  account     accounts     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  notes       notes[]
  tags        tag[]
  attachments attachments[]
  comments    comments[]
  configs     config[]
  noteHistory noteHistory[]

  @@index([accountId])
  @@index([isDefault])
}

model attachments {
  id            Int      @id @default(autoincrement())
  name          String   @default("") @db.VarChar
  path          String   @default("") @db.VarChar
  size          Decimal  @default(0) @db.Decimal
  type          String   @default("") @db.VarChar
  noteId        Int?
  accountId     Int?
  workspaceId   Int?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)
  perfixPath    String?  @default("") @db.VarChar // folder1,folder2,folder3
  depth         Int?
  metadata      Json?           @db.Json

  note      notes?      @relation(fields: [noteId], references: [id])
  account   accounts?   @relation(fields: [accountId], references: [id])
  workspace workspaces? @relation(fields: [workspaceId], references: [id])

  @@index([accountId, workspaceId])
  @@index([workspaceId])
}

model config {
  id          Int       @id @default(autoincrement())
  key         String    @default("") @db.VarChar
  config      Json?     @db.Json
  userId      Int?
  workspaceId Int?
  user        accounts? @relation(fields: [userId], references: [id])
  workspace   workspaces? @relation(fields: [workspaceId], references: [id])

  @@index([userId, workspaceId])
  @@index([workspaceId])
}

model notes {
  id                Int             @id @default(autoincrement())
  type              Int             @default(0)
  content           String          @default("") @db.VarChar
  isArchived        Boolean         @default(false)
  isRecycle         Boolean         @default(false)
  isTop             Boolean         @default(false)
  isReviewed        Boolean         @default(false)
  metadata          Json?           @db.Json
  accountId         Int?
  workspaceId       Int?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)
  attachments       attachments[]
  tags              tagsToNote[]
  account           accounts?       @relation(fields: [accountId], references: [id])
  workspace         workspaces?     @relation(fields: [workspaceId], references: [id])
  referencedBy      noteReference[] @relation("ReferencedNote")
  references        noteReference[] @relation("ReferencingNote")
  histories         noteHistory[]
  comments          comments[]

  @@index([accountId, workspaceId])
  @@index([workspaceId])
}

model comments {
  id          Int        @id @default(autoincrement())
  content     String     @db.Text
  kind        String     @default("annotation") @db.VarChar
  status      String     @default("open") @db.VarChar
  metadata    Json?      @db.Json
  accountId   Int?
  noteId      Int
  workspaceId Int?
  parentId    Int?
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)

  account   accounts?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  note      notes      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  workspace workspaces? @relation(fields: [workspaceId], references: [id])
  parent    comments?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   comments[] @relation("CommentReplies")

  @@index([noteId])
  @@index([accountId])
  @@index([workspaceId])
  @@index([kind])
  @@index([status])
  @@index([parentId])
}

model tag {
  id          Int          @id @default(autoincrement())
  name        String       @default("") @db.VarChar
  icon        String       @default("") @db.VarChar
  parent      Int          @default(0)
  accountId   Int?
  workspaceId Int?
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  tagsToNote  tagsToNote[]
  sortOrder   Int          @default(0)
  account     accounts?    @relation(fields: [accountId], references: [id])
  workspace   workspaces?  @relation(fields: [workspaceId], references: [id])

  @@index([accountId, workspaceId])
  @@index([workspaceId])
}

model tagsToNote {
  id     Int @default(autoincrement())
  noteId Int @default(0)
  tagId  Int @default(0)

  note notes @relation(fields: [noteId], references: [id])
  tag  tag   @relation(fields: [tagId], references: [id])

  @@id([noteId, tagId])
}

model noteReference {
  id         Int      @id @default(autoincrement())
  fromNoteId Int
  toNoteId   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  fromNote notes @relation("ReferencingNote", fields: [fromNoteId], references: [id])
  toNote   notes @relation("ReferencedNote", fields: [toNoteId], references: [id])

  @@unique([fromNoteId, toNoteId])
}

model cache {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar
  value     Json     @db.Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model noteHistory {
  id          Int      @id @default(autoincrement())
  noteId      Int
  content     String   @db.Text
  metadata    Json?    @db.Json
  version     Int
  accountId   Int?
  workspaceId Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  note      notes       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  workspace workspaces? @relation(fields: [workspaceId], references: [id])

  @@index([noteId])
  @@index([accountId])
  @@index([workspaceId])
}

model session {
  id        String   @id
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([expiresAt])
}

model aiProviders {
  id        Int      @id @default(autoincrement())
  title     String   @db.VarChar(255)
  provider  String   @db.VarChar(50)
  baseURL   String?  @db.VarChar(500)
  apiKey    String?  @db.VarChar(500)
  config    Json?    @db.Json
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  models    aiModels[]
}

model aiModels {
  id            Int      @id @default(autoincrement())
  providerId    Int
  title         String   @db.VarChar(255)
  modelKey      String   @db.VarChar(255)
  capabilities  Json     @db.Json
  config        Json?    @db.Json
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  provider      aiProviders @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

model fonts {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)           // Font family name (e.g., "Roboto")
  displayName String   @db.VarChar(255)           // Display name in UI
  url         String?  @db.Text                   // CDN URL for the font CSS (Google Fonts style)
  fileData    Bytes?   @db.ByteA                  // Font
  isLocal     Boolean  @default(false)            // True if font is loaded from local files
  isSystem    Boolean  @default(false)
  weights     Json     @db.Json                   // Available weights: [400, 500, 700]
  category    String   @default("sans-serif") @db.VarChar(50) // serif, sans-serif, monospace, display, handwriting
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  @@unique([name])
}
