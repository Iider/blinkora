{
  "name": "blinkora-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.2.8",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "bun run dev:frontend",
    "dev:frontend": "dotenv turbo run dev --filter=@blinkora/frontend",
    "dev:rust": "PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" PORT=\"${PORT:-6677}\" DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:mysecretpassword@localhost:55433/postgres}\" PUBLIC_PATH=\"${PUBLIC_PATH:-dist/public}\" DATA_DIR=\"${DATA_DIR:-docker/data/blinkora-rust}\" MIGRATIONS_DIR=\"${MIGRATIONS_DIR:-prisma/migrations}\" cargo run --manifest-path server-rust/Cargo.toml",
    "dev:backend": "dotenv turbo run dev --filter=@blinkora/backend",
    "build:web": "turbo run build:web",
    "test": "bun test server/__tests__/unit shared/lib/__tests__",
    "test:rust": "bun run verify:rust",
    "test:all": "bun run test && bun run test:rust",
    "start:reference:production": "ncp dist/public server/public && cd server && bun run start",
    "clean": "turbo run clean && rm -rf node_modules",
    "postinstall": "turbo run prisma:generate --filter=@blinkora/backend",
    "setup": "bun install",
    "prisma:generate": "cd prisma && prisma generate",
    "prisma:migrate:dev": "cd prisma && prisma migrate dev",
    "prisma:migrate:deploy": "cd prisma && prisma migrate deploy",
    "prisma:studio": "cd prisma && prisma studio",
    "build:seed": "tsup prisma/seed.ts --outDir dist",
    "seed": "bun dist/seed.js",
    "build:rust-release": "bash scripts/build-rust-release.sh",
    "smoke:rust": "node scripts/rust-smoke.mjs",
    "audit:rust-trpc": "node scripts/audit-rust-trpc-parity.mjs",
    "audit:rust-rest": "node scripts/audit-rust-rest-parity.mjs",
    "verify:rust": "node scripts/verify-rust-acceptance.mjs"
  },
  "devDependencies": {
    "@types/lru-cache": "^7.10.10",
    "concurrently": "^9.1.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "turbo": "2.7.2",
    "typescript": "^5.1.6"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "lru-cache": "^11.1.0",
    "react-i18next": "^15.4.1",
    "react-simple-pull-to-refresh": "^1.3.3",
    "wait-on": "^8.0.3"
  }
}
