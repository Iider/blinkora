{
  "name": "blinkora-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.2.8",
  "workspaces": [
    "app",
    "shared"
  ],
  "scripts": {
    "dev": "bun run dev:frontend",
    "dev:frontend": "turbo run dev --filter=@blinkora/frontend",
    "dev:rust": "PATH=\"/opt/homebrew/opt/rustup/bin:$HOME/.cargo/bin:$PATH\" PORT=\"${PORT:-6677}\" DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:mysecretpassword@localhost:55433/postgres}\" PUBLIC_PATH=\"${PUBLIC_PATH:-dist/public}\" DATA_DIR=\"${DATA_DIR:-docker/data/blinkora}\" SCHEMA_PATH=\"${SCHEMA_PATH:-db/schema.sql}\" cargo run --manifest-path server/Cargo.toml",
    "build:web": "turbo run build:web",
    "test": "bun test shared/lib/__tests__",
    "test:rust": "bun run verify:rust",
    "test:all": "bun run test && bun run test:rust",
    "clean": "turbo run clean && rm -rf node_modules",
    "setup": "bun install",
    "build:rust-release": "bash scripts/build-rust-release.sh",
    "deploy:local": "bash scripts/local-persistent-deploy.sh",
    "smoke:rust": "node scripts/rust-smoke.mjs",
    "smoke:agent": "node scripts/workspace-agent-smoke.mjs",
    "verify:rust": "node scripts/verify-rust-acceptance.mjs"
  },
  "devDependencies": {
    "turbo": "2.7.2"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  }
}
