FROM debian:bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=6676
ENV PUBLIC_PATH=/app/public
ENV DATA_DIR=/app/.blinkora
ENV TRUST_PROXY=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
    && rm -rf /var/lib/apt/lists/*

COPY release/rust/blinkora-server /app/blinkora-server
COPY release/rust/public /app/public
COPY release/rust/db/schema.sql /app/db/schema.sql

RUN chmod +x /app/blinkora-server

EXPOSE 6676

CMD ["/app/blinkora-server"]
